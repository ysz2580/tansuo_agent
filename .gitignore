# 运行时产物
data/
__pycache__/
*.pyc
*.db
*.db-journal
*.db-wal
*.db-shm

# MNIST 数据缓存（examples/train_mnist.py 会下载到 ./mnist_data）
mnist_data/

# 前端
web/node_modules/
web/*.tsbuildinfo
# 注：web/dist（前端构建产物）随仓库提交，保证其它机器克隆后无需 Node 即可用 Web 界面；
# 修改前端后需重新 `cd web && npm run build` 并把 dist 一并提交。

# 本地工具状态（Claude Code 会话/计划等）
.claude/
