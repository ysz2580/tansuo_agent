# tansuo_agent 本地环境变量模板
# 用法：复制本文件为同目录的 .env 并填入真实值。
#   .env 已被 gitignore，凭据只留在本机项目目录里，不会进仓库。
# 格式：每行 KEY=VALUE；以 # 开头的行是注释；空行忽略。
#   值两侧的空格与引号会被自动去除（不要给值加引号）；
#   支持 export 前缀；值里可含等号；值中避免使用半角感叹号。
# 加载时机：dev.bat 启动时自动加载（同名环境变量会被 .env 覆盖）；
#   注意——直接 python cli.py web 不会加载 .env。

# 监督 agent 的大模型凭据（必填）。
# 填入后 settings.yaml 里的 ${ENV:ANTHROPIC_AUTH_TOKEN:} 引用会自动解析到。
ANTHROPIC_AUTH_TOKEN=

# 大模型 API 端点。留空 = 使用 SDK 默认端点。
ANTHROPIC_BASE_URL=
